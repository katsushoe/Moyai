<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Moyai.Application\Moyai.Application.csproj" />
    <ProjectReference Include="..\Moyai.Configuration\Moyai.Configuration.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>moyaictl</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CreateMcpClientAlias" AfterTargets="Build" Condition="Exists('$(TargetDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).exe" DestinationFiles="$(TargetDir)moyaimcp.exe" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)moyaimcp.exe" />
    </ItemGroup>
  </Target>

  <Target Name="PublishMcpClientAlias" AfterTargets="Publish" Condition="Exists('$(PublishDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)moyaimcp.exe" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(PublishDir)moyaimcp.exe" />
    </ItemGroup>
  </Target>

</Project>
